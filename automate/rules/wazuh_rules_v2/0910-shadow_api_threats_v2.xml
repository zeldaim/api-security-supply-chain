<!-- 자동생성: yara_to_wazuh.py · 2026-11-09 -->
<!-- 원본: api-bom/yara/rules/http_attacks_v2.yar -->
<!-- 배포: sudo cp <this file> /var/ossec/etc/rules/ && sudo systemctl restart wazuh-manager -->

<group name="shadow_api_threats,web,attack,">

  <!-- ── SQLInjection_Union (CWE-89) ── -->
  <rule id="100910" level="14">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">(?i:union(?:\ |%20|\+)select)|(?i:union(?:\ |%20|\+)all(?:\ |%20|\+)select)|(?i:'(?:\ |%20|\+)or(?:\ |%20|\+)1=1)|(?i:\x22(?:\ |%20|\+)or(?:\ |%20|\+)1=1)|(?i:or(?:\ |%20|\+)'1'='1')</url>
    <description>SQL UNION 기반 인젝션 (CWE-89)</description>
    <group>attack,</group>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- ── SQLInjection_Stacked (CWE-89) ── -->
  <rule id="100911" level="14">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">(?i:sleep\()|(?i:waitfor(?:\ |%20|\+)delay)|(?i:benchmark\()|(?i:';(?:\ |%20|\+)drop(?:\ |%20|\+)table)|(?i:';(?:\ |%20|\+)insert(?:\ |%20|\+)into)</url>
    <description>SQL 스택드 쿼리 / time-based blind (CWE-89)</description>
    <group>attack,</group>
    <mitre><id>T1190</id></mitre>
  </rule>

  <!-- ── PathTraversal (CWE-22) ── -->
  <rule id="100912" level="12">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">\.\./|(?i:\.\.%2f)|(?i:\.\.%5c)|(?i:%2e%2e%2f)|/etc/passwd|(?i:\\windows\\system32)</url>
    <description>경로 순회 공격 (CWE-22)</description>
    <group>attack,</group>
    <mitre><id>T1083</id></mitre>
  </rule>

  <!-- ── CommandInjection (CWE-78) ── -->
  <rule id="100913" level="14">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">;id|;ls|;cat(?:\ |%20|\+)|\|id|\|whoami|`id`|\$\(id\)|;ping(?:\ |%20|\+)\-c(?:\ |%20|\+)1|;ping\+\-c\+1</url>
    <description>OS 명령 주입 (CWE-78)</description>
    <group>attack,</group>
    <mitre><id>T1059</id></mitre>
  </rule>

  <!-- ── JWTTampering (CWE-345) ── -->
  <rule id="100914" level="12">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">eyJhbGciOiJub25lIn0|(?i:algorithm\x22:\x22none\x22)</url>
    <description>JWT alg:none 위조 시도 (CWE-345)</description>
    <group>attack,</group>
    <mitre><id>T1550</id></mitre>
  </rule>

  <!-- ── XSSReflected (CWE-79) ── -->
  <rule id="100915" level="10">
    <if_sid>31100, 31103, 31104, 31105, 31106</if_sid>
    <url type="pcre2">(?i:\x3cscript\x3e)|(?i:javascript:)|(?i:onerror=)|(?i:onload=)|(?i:%3cscript%3e)</url>
    <description>반사형 XSS 시도 (CWE-79)</description>
    <group>web,attack,</group>
    <mitre><id>T1189</id></mitre>
  </rule>

</group>
