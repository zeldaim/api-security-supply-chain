# spring-petclinic 용 설정 (v2.1) — 다섯 번째 처음 보는 앱, 첫 Spring 앱, 명세(OpenAPI) 없음. 워크플로 코드는 그대로, 이 파일만.
# 명세는 source_to_baseline.py(Spring 추출기)가 소스에서 만든 API-BOM → openapi --include-pages 로 만든 허용 목록을 쓴다.
LAB_SSH=
SPEC_PATH=verify/petclinic/rules_2026-11-21/work/petclinic-openapi.json
SPEC_URL=
WEB_LOG=verify/petclinic/rules_2026-11-21/work/logs/access.log
TRAIN_WINDOW=5
TARGET_APP=petclinic
DRY=1
STATE_DIR=verify/petclinic/rules_2026-11-21/state
LOG_FORMAT=accesslog
BOLA_TARGETS=/owners/{id}
