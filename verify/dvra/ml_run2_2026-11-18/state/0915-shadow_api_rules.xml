<!--
  Shadow API 탐지 룰 — 웹 접근 로그용 (자동 생성: gen_shadow_rules_v2.py build 로 다시 만드세요)
  생성 시각 : 2026-11-18T09:09:43+00:00
  명세 원본 : verify/dvra/ml_run2_2026-11-18/state/spec.yaml
  명세 SHA256: 97ad8622bae2a589c0384617ccd19ed46bd996fa06ff4ceb4af096637909442b
  명세 작업 수: 21 (예외 목록 0건 포함)
  검사 범위 : ^/(?!(?:\?|$))(?![^?]*\.(?:css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|map|html?|txt)(?:\?|$))
  필드: url(경로+쿼리) · protocol(메서드) · id(응답 코드) · srcip — Wazuh web-accesslog 디코더
    DELETE  /menu/{item_id}
    GET     /admin/stats/disk
    GET     /discount-coupons
    GET     /healthcheck
    GET     /menu
    GET     /orders
    GET     /orders/status/{order_id}
    GET     /orders/{order_id}
    GET     /profile
    GET     /referral-code
    PATCH   /profile
    POST    /apply-referral
    POST    /orders
    POST    /register
    POST    /reset-password
    POST    /reset-password/new-password
    POST    /token
    PUT     /menu
    PUT     /menu/{item_id}
    PUT     /profile
    PUT     /users/update_role
-->
<group name="shadow_api,">

  <!-- 기반: 접근 로그의 API 범위 요청. 명세 안 요청은 여기서 끝난다 (레벨 0 = 경보 없음) -->
  <rule id="100500" level="0">
    <if_sid>31100, 31101, 31108, 31120, 31121, 31122, 31123</if_sid>
    <url type="pcre2">^/(?!(?:\?|$))(?![^?]*\.(?:css|js|png|jpe?g|gif|svg|ico|woff2?|ttf|map|html?|txt)(?:\?|$))</url>
    <description>API 요청 (명세 범위)</description>
  </rule>

  <!-- 명세 밖 판정: 명세에 아예 없는 메서드 -->
  <rule id="100501" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2" negate="yes">^(?:DELETE|GET|PATCH|POST|PUT)$</protocol>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 명세 밖 판정: DELETE 인데 명세의 DELETE 경로(1개) 어디에도 맞지 않음 -->
  <rule id="100502" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2">^DELETE$</protocol>
    <url type="pcre2" negate="yes">^(?:/menu/\d+)/*(?:\?.*)?$</url>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 명세 밖 판정: GET 인데 명세의 GET 경로(9개) 어디에도 맞지 않음 -->
  <rule id="100503" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2">^GET$</protocol>
    <url type="pcre2" negate="yes">^(?:/admin/stats/disk|/discount\-coupons|/healthcheck|/menu|/orders|/orders/\d+|/orders/status/\d+|/profile|/referral\-code)/*(?:\?.*)?$</url>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 명세 밖 판정: PATCH 인데 명세의 PATCH 경로(1개) 어디에도 맞지 않음 -->
  <rule id="100504" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2">^PATCH$</protocol>
    <url type="pcre2" negate="yes">^(?:/profile)/*(?:\?.*)?$</url>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 명세 밖 판정: POST 인데 명세의 POST 경로(6개) 어디에도 맞지 않음 -->
  <rule id="100505" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2">^POST$</protocol>
    <url type="pcre2" negate="yes">^(?:/apply\-referral|/orders|/register|/reset\-password|/reset\-password/new\-password|/token)/*(?:\?.*)?$</url>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 명세 밖 판정: PUT 인데 명세의 PUT 경로(4개) 어디에도 맞지 않음 -->
  <rule id="100506" level="6">
    <if_sid>100500</if_sid>
    <protocol type="pcre2">^PUT$</protocol>
    <url type="pcre2" negate="yes">^(?:/menu|/menu/\d+|/profile|/users/update_role)/*(?:\?.*)?$</url>
    <description>[Shadow API] 명세 밖 호출: $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_undocumented,</group>
  </rule>

  <!-- 단계: 명세 밖 호출을 응답 코드로 분류 -->
  <rule id="100510" level="5">
    <if_group>shadow_api_undocumented</if_group>
    <id type="pcre2">^40[45]$</id>
    <description>[Shadow API L1 정찰] $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_recon,</group>
  </rule>
  <rule id="100511" level="8">
    <if_group>shadow_api_undocumented</if_group>
    <id type="pcre2">^40[13]$</id>
    <description>[Shadow API L2 발견] $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_discovery,</group>
  </rule>
  <rule id="100512" level="12">
    <if_group>shadow_api_undocumented</if_group>
    <id type="pcre2">^2\d\d$</id>
    <description>[Shadow API L3 악용] $(srcip) $(protocol) $(url)</description>
    <mitre><id>T1190</id></mitre>
    <group>shadow_api_exploit,</group>
  </rule>
  <rule id="100513" level="10">
    <if_group>shadow_api_undocumented</if_group>
    <id type="pcre2">^5\d\d$</id>
    <description>[Shadow API L3-E 서버 오류] $(srcip) $(protocol) $(url)</description>
    <group>shadow_api_error,</group>
  </rule>

  <!-- 빈도: 같은 출발지 IP 가 짧은 시간에 반복 -->
  <rule id="100520" level="10" frequency="20" timeframe="30" ignore="60">
    <if_matched_sid>100510</if_matched_sid>
    <same_srcip />
    <description>[Shadow API F1 자동화 정찰] $(srcip) 30초 안에 L1 20회 이상</description>
    <mitre><id>T1595.003</id></mitre>
    <group>shadow_api_recon_burst,</group>
  </rule>
  <rule id="100521" level="14" frequency="10" timeframe="60" ignore="60">
    <if_matched_sid>100512</if_matched_sid>
    <same_srcip />
    <description>[Shadow API F2 대량 유출] $(srcip) 60초 안에 L3 10회 이상</description>
    <mitre><id>T1119</id></mitre>
    <group>shadow_api_mass_exfil,</group>
  </rule>

</group>
