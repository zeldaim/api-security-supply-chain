# 실제 화면 녹화용: 가상 화면(Xvfb) + 터미널(xterm) + 화면 캡처(ffmpeg x11grab) + docker CLI
#   docker build -q -t demo-rec -f Dockerfile.rec .
FROM python:3.12-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends xvfb xterm ffmpeg fonts-nanum fonts-dejavu-core curl ca-certificates procps \
 && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir pyyaml==6.0.2 \
 && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz | tar -xz -C /tmp && mv /tmp/docker/docker /usr/local/bin/docker && rm -rf /tmp/docker
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
